# Entity: currency

main: kit: entity: currency: {

  alias: field: {}

  fields: [
    {
      name: "code"
      req: false
      short: "Currency code (ISO 4217)"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the currency"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "Currency name"
      type: "`$STRING`"
    }
    {
      name: "symbol"
      req: false
      short: "Currency symbol"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "currency"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/currencies"
          parts: [
            "currencies"
          ]
          select: {
            exist: [
              "limit"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
